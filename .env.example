# Copy to .env and fill in ONE key. The app works with none of them set
# (it degrades to a clearly-labelled rule-based answer mode), but a key makes
# the answers read like a real assistant.
#
# Providers are tried in this order, falling through on error or rate limit:
#   OpenAI  ->  Groq  ->  Google Gemini  ->  OpenRouter  ->  rule-based fallback

# 0) OpenAI - paid, but this demo costs roughly 0.2 cents per question on
#    gpt-4.1-mini. Most reliable tool-calling of the four.
#    https://platform.openai.com/api-keys
OPENAI_API_KEY=

# 1) Groq - free, no credit card, very fast, does not train on your prompts.
#    Get one at https://console.groq.com/keys  (recommended)
GROQ_API_KEY=

# 2) Google Gemini - free tier, no card. https://aistudio.google.com/apikey
GEMINI_API_KEY=

# 3) OpenRouter - free models, one key, no card. https://openrouter.ai/keys
OPENROUTER_API_KEY=

# --- optional overrides -----------------------------------------------------
# Pin a specific model instead of letting the app resolve one from the
# provider's live model list:
# OPENAI_MODEL=gpt-4.1-mini
# GROQ_MODEL=llama-3.3-70b-versatile
# GEMINI_MODEL=gemini-2.5-flash-lite
# OPENROUTER_MODEL=z-ai/glm-5.2:free

# Retrieval backend: tfidf (default, no downloads) or gemini (remote embeddings API)
RETRIEVER=tfidf

# Port to serve on
PORT=7860

# Set to 1 for a temporary public *.gradio.live link (fallback if the VPS port
# is not reachable). Off by default.
GRADIO_SHARE=0
